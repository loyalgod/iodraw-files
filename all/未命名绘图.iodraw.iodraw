xt x=&quot;240&quot; y=&quot;143&quot; text-anchor=&quot;middle&quot; dominant-baseline=&quot;central&quot;&gt;初始化各子种群&lt;/text&gt;&#xa;&#xa;&#xa;&lt;line x1=&quot;240&quot; y1=&quot;160&quot; x2=&quot;240&quot; y2=&quot;180&quot; stroke=&quot;black&quot; stroke-width=&quot;1.5&quot; marker-end=&quot;url(#arr)&quot;/&gt;&#xa;&#xa;&#xa;&lt;!-- 随机初始化DQN --&gt;&#xa;&lt;rect x=&quot;130&quot; y=&quot;180&quot; width=&quot;220&quot; height=&quot;34&quot; fill=&quot;white&quot; stroke=&quot;black&quot; stroke-width=&quot;1.5&quot;/&gt;&#xa;&lt;text x=&quot;240&quot; y=&quot;197&quot; text-anchor=&quot;middle&quot; dominant-baseline=&quot;central&quot;&gt;随机初始化 DQN&lt;/text&gt;&#xa;&#xa;&#xa;&lt;line x1=&quot;240&quot; y1=&quot;214&quot; x2=&quot;240&quot; y2=&quot;234&quot; stroke=&quot;black&quot; stroke-width=&quot;1.5&quot; marker-end=&quot;url(#arr)&quot;/&gt;&#xa;&#xa;&#xa;&lt;!-- 终止条件 菱形 cx=240 cy=262 --&gt;&#xa;&lt;polygon points=&quot;240,234 310,262 240,290 170,262&quot;&#xa;         fill=&quot;white&quot; stroke=&quot;black&quot; stroke-width=&quot;1.5&quot;/&gt;&#xa;&lt;text x=&quot;240&quot; y=&quot;266&quot; text-anchor=&quot;middle&quot; dominant-baseline=&quot;central&quot;&gt;终止条件&lt;/text&gt;&#xa;&#xa;&#xa;&lt;!-- Y → 右 → 输出最终解集 → 结束 --&gt;&#xa;&lt;line x1=&quot;310&quot; y1=&quot;262&quot; x2=&quot;358&quot; y2=&quot;262&quot; stroke=&quot;black&quot; stroke-width=&quot;1.5&quot; marker-end=&quot;url(#arr)&quot;/&gt;&#xa;&lt;text x=&quot;318&quot; y=&quot;256&quot; font-size=&quot;11&quot;&gt;Y&lt;/text&gt;&#xa;&#xa;&#xa;&lt;rect x=&quot;358&quot; y=&quot;244&quot; width=&quot;100&quot; height=&quot;36&quot; fill=&quot;white&quot; stroke=&quot;black&quot; stroke-width=&quot;1.5&quot;/&gt;&#xa;&lt;text x=&quot;408&quot; y=&quot;262&quot; text-anchor=&quot;middle&quot; dominant-baseline=&quot;central&quot; font-size=&quot;12&quot;&gt;输出最终解集&lt;/text&gt;&#xa;&#xa;&#xa;&lt;line x1=&quot;408&quot; y1=&quot;280&quot; x2=&quot;408&quot; y2=&quot;308&quot; stroke=&quot;black&quot; stroke-width=&quot;1.5&quot; marker-end=&quot;url(#arr)&quot;/&gt;&#xa;&#xa;&#xa;&lt;ellipse cx=&quot;408&quot; cy=&quot;325&quot; rx=&quot;38&quot; ry=&quot;19&quot; fill=&quot;white&quot; stroke=&quot;black&quot; stroke-width=&quot;1.5&quot;/&gt;&#xa;&lt;text x=&quot;408&quot; y=&quot;329&quot; text-anchor=&quot;middle&quot; dominant-baseline=&quot;central&quot;&gt;结束&lt;/text&gt;&#xa;&#xa;&#xa;&lt;!-- N ↓ --&gt;&#xa;&lt;line x1=&quot;240&quot; y1=&quot;290&quot; x2=&quot;240&quot; y2=&quot;312&quot; stroke=&quot;black&quot; stroke-width=&quot;1.5&quot; marker-end=&quot;url(#arr)&quot;/&gt;&#xa;&lt;text x=&quot;245&quot; y=&quot;306&quot; font-size=&quot;11&quot;&gt;N&lt;/text&gt;&#xa;&#xa;&#xa;&lt;!-- 利用DQN生成MatingPool_SP --&gt;&#xa;&lt;rect x=&quot;118&quot; y=&quot;312&quot; width=&quot;244&quot; height=&quot;48&quot; fill=&quot;white&quot; stroke=&quot;black&quot; stroke-width=&quot;1.5&quot;/&gt;&#xa;&lt;text x=&quot;240&quot; y=&quot;330&quot; text-anchor=&quot;middle&quot; dominant-baseline=&quot;central&quot;&gt;利用 DQN 生成&lt;/text&gt;&#xa;&lt;text x=&quot;240&quot; y=&quot;348&quot; text-anchor=&quot;middle&quot; dominant-baseline=&quot;central&quot;&gt;MatingPool_SP&lt;/text&gt;&#xa;&#xa;&#xa;&lt;line x1=&quot;240&quot; y1=&quot;360&quot; x2=&quot;240&quot; y2=&quot;380&quot; stroke=&quot;black&quot; stroke-width=&quot;1.5&quot; marker-end=&quot;url(#arr)&quot;/&gt;&#xa;&#xa;&#xa;&lt;!-- 轮盘赌生成MatingPool_Value --&gt;&#xa;&lt;rect x=&quot;75&quot; y=&quot;380&quot; width=&quot;330&quot; height=&quot;64&quot; fill=&quot;white&quot; stroke=&quot;black&quot; stroke-width=&quot;1.5&quot;/&gt;&#xa;&lt;text x=&quot;240&quot; y=&quot;398&quot; text-anchor=&quot;middle&quot; dominant-baseline=&quot;central&quot;&gt;以一定概率应用轮盘赌法基于&lt;/text&gt;&#xa;&lt;text x=&quot;240&quot; y=&quot;416&quot; text-anchor=&quot;middle&quot; dominant-baseline=&quot;central&quot;&gt;效用值Π（或随机法）生成&lt;/text&gt;&#xa;&lt;text x=&quot;240&quot; y=&quot;434&quot; text-anchor=&quot;middle&quot; dominant-baseline=&quot;central&quot;&gt;MatingPool_Value&lt;/text&gt;&#xa;&#xa;&#xa;&lt;line x1=&quot;240&quot; y1=&quot;444&quot; x2=&quot;240&quot; y2=&quot;464&quot; stroke=&quot;black&quot; stroke-width=&quot;1.5&quot; marker-end=&quot;url(#arr)&quot;/&gt;&#xa;&#xa;&#xa;&lt;!-- 遗传算子生成子代offspring --&gt;&#xa;&lt;rect x=&quot;118&quot; y=&quot;464&quot; width=&quot;244&quot; height=&quot;48&quot; fill=&quot;white&quot; stroke=&quot;black&quot; stroke-width=&quot;1.5&quot;/&gt;&#xa;&lt;text x=&quot;240&quot; y=&quot;482&quot; text-anchor=&quot;middle&quot; dominant-baseline=&quot;central&quot;&gt;遗传算子生成子代&lt;/text&gt;&#xa;&lt;text x=&quot;240&quot; y=&quot;500&quot; text-anchor=&quot;middle&quot; dominant-baseline=&quot;central&quot;&gt;offspring&lt;/text&gt;&#xa;&#xa;&#xa;&lt;line x1=&quot;240&quot; y1=&quot;512&quot; x2=&quot;240&quot; y2=&quot;532&quot; stroke=&quot;black&quot; stroke-width=&quot;1.5&quot; marker-end=&quot;url(#arr)&quot;/&gt;&#xa;&#xa;&#xa;&lt;!-- 计算父代与子代解的适应度值 --&gt;&#xa;&lt;rect x=&quot;98&quot; y=&quot;532&quot; width=&quot;284&quot; height=&quot;48&quot; fill=&quot;white&quot; stroke=&quot;black&quot; stroke-width=&quot;1.5&quot;/&gt;&#xa;&lt;text x=&quot;240&quot; y=&quot;550&quot; text-anchor=&quot;middle&quot; dominant-baseline=&quot;central&quot;&gt;计算父代与子代解的&lt;/text&gt;&#xa;&lt;text x=&quot;240&quot; y=&quot;568&quot; text-anchor=&quot;middle&quot; dominant-baseline=&quot;central&quot;&gt;适应度值&lt;/text&gt;&#xa;&#xa;&#xa;&lt;line x1=&quot;240&quot; y1=&quot;580&quot; x2=&quot;240&quot; y2=&quot;600&quot; stroke=&quot;black&quot; stroke-width=&quot;1.5&quot; marker-end=&quot;url(#arr)&quot;/&gt;&#xa;&#xa;&#xa;&lt;!-- 环境选择更新种群，计算Reward，更新DQN --&gt;&#xa;&lt;rect x=&quot;68&quot; y=&quot;600&quot; width=&quot;344&quot; height=&quot;64&quot; fill=&quot;white&quot; stroke=&quot;black&quot; stroke-width=&quot;1.5&quot;/&gt;&#xa;&lt;text x=&quot;240&quot; y=&quot;618&quot; text-anchor=&quot;middle&quot; dominant-baseline=&quot;central&quot;&gt;环境选择更新种群，并计算&lt;/text&gt;&#xa;&lt;text x=&quot;240&quot; y=&quot;636&quot; text-anchor=&quot;middle&quot; dominant-baseline=&quot;central&quot;&gt;Reward 与损失函数&lt;/text&gt;&#xa;&lt;text x=&quot;240&quot; y=&quot;654&quot; text-anchor=&quot;middle&quot; dominant-baseline=&quot;central&quot;&gt;更新 DQN&lt;/text&gt;&#xa;&#xa;&#xa;&lt;line x1=&quot;240&quot; y1=&quot;664&quot; x2=&quot;240&quot; y2=&quot;684&quot; stroke=&quot;black&quot; stroke-width=&quot;1.5&quot; marker-end=&quot;url(#arr)&quot;/&gt;&#xa;&#xa;&#xa;&lt;!-- 子种群资源分配更新条件 菱形 cx=240 cy=720 --&gt;&#xa;&lt;polygon points=&quot;240,684 318,720 240,756 162,720&quot;&#xa;         fill=&quot;white&quot; stroke=&quot;black&quot; stroke-width=&quot;1.5&quot;/&gt;&#xa;&lt;text x=&quot;240&quot; y=&quot;712&quot; text-anchor=&quot;middle&quot; dominant-baseline=&quot;central&quot;&gt;子种群资源&lt;/text&gt;&#xa;&lt;text x=&quot;240&quot; y=&quot;728&quot; text-anchor=&quot;middle&quot; dominant-baseline=&quot;central&quot;&gt;分配更新条件&lt;/text&gt;&#xa;&#xa;&#xa;&lt;!-- Y → 左 --&gt;&#xa;&lt;line x1=&quot;162&quot; y1=&quot;720&quot; x2=&quot;112&quot; y2=&quot;720&quot; stroke=&quot;black&quot; stroke-width=&quot;1.5&quot; marker-end=&quot;url(#arr)&quot;/&gt;&#xa;&lt;text x=&quot;127&quot; y=&quot;713&quot; font-size=&quot;11&quot;&gt;Y&lt;/text&gt;&#xa;&#xa;&#xa;&lt;!-- 更新各子种群分配的计算资源 --&gt;&#xa;&lt;rect x=&quot;6&quot; y=&quot;700&quot; width=&quot;106&quot; height=&quot;40&quot; fill=&quot;white&quot; stroke=&quot;black&quot; stroke-width=&quot;1.5&quot;/&gt;&#xa;&lt;text x=&quot;59&quot; y=&quot;713&quot; text-anchor=&quot;middle&quot; dominant-baseline=&quot;central&quot; font-size=&quot;11&quot;&gt;更新各子种群分配&lt;/text&gt;&#xa;&lt;text x=&quot;59&quot; y=&quot;729&quot; text-anchor=&quot;middle&quot; dominant-baseline=&quot;central&quot; font-size=&quot;11&quot;&gt;的计算资源&lt;/text&gt;&#xa;&#xa;&#xa;&lt;line x1=&quot;59&quot; y1=&quot;740&quot; x2=&quot;59&quot; y2=&quot;764&quot; stroke=&quot;black&qu