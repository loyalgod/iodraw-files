        <mxCell id="gIRvnGAzCNlK1OQJmEMH-2" value="&lt;span style=&quot;color: rgb(50, 50, 50); font-family: &amp;quot;Microsoft YaHei&amp;quot;, 微软雅黑, Arial; font-size: 13px; background-color: rgba(255, 255, 255, 0.01);&quot;&gt;评估病人是否有俯卧位指征，启动清醒俯卧位治疗&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="229" y="-552" width="304" height="34" as="geometry" />
