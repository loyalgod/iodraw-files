        <mxCell id="lI3VnrNuNV7lSSgWIXS8-23" value="&lt;span style=&quot;text-align: left; font-family: 宋体; letter-spacing: 0.5pt;&quot;&gt;核对医嘱，评估病人是否&lt;/span&gt;&lt;span style=&quot;text-align: left; font-family: 宋体; letter-spacing: 0.9pt;&quot;&gt;有俯卧位适应证&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
